{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!build",
			"!coverage",
			"!profiles",
			"!postcss.config.cjs",
			"!apple_music_source.html",
			"!charts_source.html",
			"!\\[Safari\\] Settings erased on web history clear, fix inside! · Issue #1366 · uBlock-LLC:uBlock.html"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noSvgWithoutTitle": "off",
				"noLabelWithoutControl": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noDescendingSpecificity": "off"
			},
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noAssignInExpressions": "off"
			},
			"complexity": {
				"noBannedTypes": "off",
				"noImportantStyles": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
